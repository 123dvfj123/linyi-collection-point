# Copy this file to .env before running the full stack:
#   docker compose --profile full up -d --build --wait
# These are development defaults. Change them before any non-local use.

# --- Database ---
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_dev_only
POSTGRES_DB=lms

# --- Ports (host side; change if these clash with something already running) ---
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8080
FRONTEND_PORT=80

# --- Frontend ---
# Consumed by Vite at build time. /api matches the OpenAPI server path and is
# proxied to the backend by Nginx. Final value is set by R4 in issue #82.
VITE_API_BASE_URL=/api

# --- Backend ---
# ISO-8601 duration for a newly issued pickup code; P7D = seven days.
PICKUP_CODE_VALIDITY=P7D